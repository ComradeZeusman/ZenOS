{
    "configurations": [
        {
            "name": "ZenOS (i686-elf-gcc)",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "__GNUC__",
                "__i386__"
            ],
            "compilerPath": "i686-elf-gcc",
            "compilerArgs": [
                "-m32",
                "-ffreestanding",
                "-nostdinc",
                "-nostdlib"
            ],
            "cStandard": "c11",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}
